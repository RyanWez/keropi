# Required: get one from @BotFather
BOT_TOKEN=paste-your-botfather-token-here

# DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Port for the health-check HTTP server. Render sets this automatically.
# Leave unset (or 0) to run polling only, with no open port.
# PORT=8080

# Where to keep user preferences. On Render's free tier the filesystem is
# ephemeral, so this file is recreated after every restart.
# DB_PATH=bot.db

# Telegram user id allowed to run diagnostic commands. Unset disables them.
# OWNER_ID=

# KBZPay's QR stores the recipient's number in a fixed 6-byte field that holds
# exactly 11 digits. Myanmar also has legacy 9- and 10-digit mobile numbers;
# padding those to fill the field keeps the payload aligned but has NOT been
# confirmed against KBZPay's server, which is what builds the payload. Turn this
# on only to test against a real legacy-number account.
# KBZPAY_ALLOW_SHORT_NUMBERS=false
